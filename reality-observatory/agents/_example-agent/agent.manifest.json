{
  "id": "example-agent",
  "displayName": "Example Agent",
  "version": "0.1.0",
  "owner": "platform-team",
  "description": "Skeleton showing the manifest shape required by AgentManifest. Not a real agent.",
  "io": {
    "consumesTopics": ["signal.example.*"],
