{
  "name": "reality-observatory",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "reality-observatory",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "agents/*"
      ],
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "agents/_example-agent": {
      "name": "@reality-observatory/agent-example",
      "version": "0.1.0",
      "dependencies": {
        "@reality-observatory/agent-sdk": "*",
        "@reality-observatory/ontology": "*"
      }
    },
    "node_modules/@reality-observatory/agent-example": {
      "resolved": "agents/_example-agent",
      "link": true
    },
    "node_modules/@reality-observatory/agent-sdk": {
      "resolved": "packages/agent-sdk",
      "link": true
    },
    "node_modules/@reality-observatory/correlation-engine": {
      "resolved": "packages/correlation-engine",
      "link": true
    },
    "node_modules/@reality-observatory/event-bus": {
      "resolved": "packages/event-bus",
      "link": true
    },
    "node_modules/@reality-observatory/ontology": {
      "resolved": "packages/ontology",
      "link": true
    },
    "node_modules/@reality-observatory/sensor-registry": {
      "resolved": "packages/sensor-registry",
      "link": true
    },
    "node_modules/@reality-observatory/trust-engine": {
      "resolved": "packages/trust-engine",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/agent-sdk": {
      "name": "@reality-observatory/agent-sdk",
      "version": "0.1.0",
      "dependencies": {
        "@reality-observatory/event-bus": "*",
        "@reality-observatory/ontology": "*",
        "@reality-observatory/sensor-registry": "*",
        "@reality-observatory/trust-engine": "*"
      },
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "packages/correlation-engine": {
      "name": "@reality-observatory/correlation-engine",
      "version": "0.1.0",
      "dependencies": {
        "@reality-observatory/event-bus": "*",
        "@reality-observatory/ontology": "*",
        "@reality-observatory/sensor-registry": "*",
        "@reality-observatory/trust-engine": "*"
      },
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "packages/event-bus": {
      "name": "@reality-observatory/event-bus",
      "version": "0.1.0",
      "dependencies": {
        "@reality-observatory/ontology": "*"
      },
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "packages/ontology": {
      "name": "@reality-observatory/ontology",
      "version": "0.1.0",
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "packages/sensor-registry": {
      "name": "@reality-observatory/sensor-registry",
      "version": "0.1.0",
      "dependencies": {
        "@reality-observatory/event-bus": "*",
        "@reality-observatory/ontology": "*"
      },
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "packages/trust-engine": {
      "name": "@reality-observatory/trust-engine",
      "version": "0.1.0",
      "dependencies": {
        "@reality-observatory/event-bus": "*",
        "@reality-observatory/ontology": "*"
      },
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    }
  }
}
